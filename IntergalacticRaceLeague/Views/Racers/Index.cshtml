@model IEnumerable<IntergalacticRaceLeague.Models.Racer>

@{
    ViewData["Title"] = "Racers";
}
<h1>Racers</h1>
<p>
    @if (User.Identity != null && User.Identity.IsAuthenticated)
    {
        <a asp-action="Create" class="btn btn-primary">
            Create New Racer
        </a>
    }
</p>
<table class="table">
    <thead>
        <tr>
            <th>Name</th>
            <th>Planet</th>
            <th>Age</th>
            <th>Vehicle</th>
            <th></th>
        </tr>
    </thead>
    <tbody>
        @foreach (var racer in Model)
        {
            <tr>
                <td>@racer.Name</td>
                <td>@racer.Planet</td>
                <td>@racer.Age</td>
                <td>@racer.Vehicle?.Name</td>
                <td>
                    <a asp-action="Details"
                       asp-route-id="@racer.Id">Details</a>

                    @if (User.Identity != null && User.Identity.IsAuthenticated)
                    {
                        <span> | </span>
                        <a asp-action="Edit"
                           asp-route-id="@racer.Id">Edit</a>
                    }
                    @if (User.IsInRole("Admin"))
                    {
                        <span> | </span>
                        <a asp-action="Delete"
                           asp-route-id="@racer.Id">Delete</a>
                    }
                </td>
            </tr>
        }
    </tbody>
</table>