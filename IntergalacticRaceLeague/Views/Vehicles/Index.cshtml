@model IEnumerable<IntergalacticRaceLeague.Models.Vehicle>

@{
    ViewData["Title"] = "Vehicles";
}

<h1>Vehicles</h1>

<p>
    <a asp-action="Create" class="btn btn-primary">Create New Vehicle</a>
</p>

<table class="table">
    <thead>
        <tr>
            <th>Name</th>
            <th>Model</th>
            <th>Top Speed</th>
            <th></th>
        </tr>
    </thead>

    <tbody>
        @foreach (var vehicle in Model)
        {
            <tr>
                <td>@vehicle.Name</td>
                <td>@vehicle.Model</td>
                <td>@vehicle.TopSpeed</td>

                <td>
                    <a asp-action="Details"
                       asp-route-id="@vehicle.Id">Details</a> |

                    <a asp-action="Edit"
                       asp-route-id="@vehicle.Id">Edit</a> |

                    <a asp-action="Delete"
                       asp-route-id="@vehicle.Id">Delete</a>
                </td>
            </tr>
        }
    </tbody>
</table>